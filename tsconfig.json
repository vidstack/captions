{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "alwaysStrict": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "useDefineForClassFields": false,
    "paths": {
      "media-captions": ["./src/index.ts"],
      "media-captions/cea": ["./src/cea/index.ts"],
      "media-captions/entities": ["./src/entities/index.ts"],
      "media-captions/element": ["./src/element/index.ts"],
      "media-captions/entities": ["./src/entities/index.ts"],
      "media-captions/mp4": ["./src/mp4/index.ts"]
    },
    "types": ["vitest/globals"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests", "playground"],
  "exclude": ["**/*.mjs", "node_modules", "dist"]
}
