    <tt:styling>
      <tt:style xml:id="defaultStyle" tts:fontFamily="Verdana, Arial, Tiresias" tts:fontSize="160%" tts:lineHeight="125%" tts:textAlign="center" tts:color="#FFFFFF" tts:backgroundColor="#00000000" tts:fontStyle="normal" tts:fontWeight="normal" tts:textDecoration="none" ebutts:linePadding="0.5c" ebutts:multiRowAlign="auto"/>
      <tt:style xml:id="textWhiteOnBlack" tts:color="#FFFFFF" tts:backgroundColor="#000000"/>
      <tt:style xml:id="textYellowOnBlack" tts:color="#FFFF00" tts:backgroundColor="#000000"/>
      <tt:style xml:id="textCyanOnBlack" tts:color="#00FFFF" tts:backgroundColor="#000000"/>
      <tt:style xml:id="italic" tts:fontStyle="italic"/>
      <tt:style xml:id="leftAlign" tts:textAlign="start" ebutts:multiRowAlign="start"/>
    </tt:styling>
    <tt:layout>
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" tts:padding="0c" tts:writingMode="lrtb" tts:overflow="visible"/>
      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" tts:padding="0c" tts:writingMode="lrtb" tts:overflow="visible"/>
