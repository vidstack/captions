        <ebuttm:documentIdentifier>tagesschau-2024-03-01</ebuttm:documentIdentifier>
        <ebuttm:documentOriginatingSystem>subtitle-export 4.2</ebuttm:documentOriginatingSystem>
        <ebuttm:documentCopyright>ARD</ebuttm:documentCopyright>
