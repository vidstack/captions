  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub1" begin="00:00:00.760" end="00:00:03.320" region="bottom"><tt:span style="textWhiteOnBlack">Guten Abend, meine Damen und Herren,</tt:span><tt:br/><tt:span style="textWhiteOnBlack">ich begrüße Sie zur Tagesschau.</tt:span></tt:p>
      <tt:p xml:id="sub2" begin="00:00:03.400" end="00:00:06.880" region="bottom"><tt:span style="textYellowOnBlack">* Wir haben heute drei Themen. *</tt:span></tt:p>
      <tt:p xml:id="sub3" begin="00:00:06.960" end="00:00:10.200" region="bottom"><tt:span style="textCyanOnBlack">Die Verhandlungen sind gescheitert.</tt:span></tt:p>
      <tt:p xml:id="sub4" begin="00:00:10.280" end="00:00:13.000" region="top"><tt:span style="textWhiteOnBlack">(Musik)</tt:span></tt:p>
      <tt:p xml:id="sub5" begin="00:00:13.080" end="00:00:16.640" region="bottom" style="leftAlign"><tt:span style="textWhiteOnBlack">- Kommst du mit?</tt:span><tt:br/><tt:span style="textYellowOnBlack">- Nein, ich bleibe hier.</tt:span></tt:p>
      <tt:p xml:id="sub6" begin="00:00:16.720" end="00:00:20.000" region="bottom"><tt:span style="textWhiteOnBlack"><tt:span style="italic">Er flüsterte:</tt:span> "Es ist Zeit."</tt:span></tt:p>
      <tt:p xml:id="sub7" begin="00:00:20.080" end="00:00:24.000" region="bottom"><tt:span style="textWhiteOnBlack">Untertitel im Auftrag des ZDF, 2024</tt:span></tt:p>
    </tt:div>
  </tt:body>
</tt:tt>
