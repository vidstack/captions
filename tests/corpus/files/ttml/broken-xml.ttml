<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en">
  <head>
    <styling>
      <style xml:id="s1" tts:color="white" tts:fontSize="80%
      <style xml:id="s2" tts:color=red/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%">
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:03.000" region="r1">Unclosed paragraph
      <p begin="00:00:03.000" end="00:00:05.000" region="missing">Region does not exist.</p>
      <p begin="bogus" end="00:00:07.000">Invalid begin time.</p>
      <p begin="00:00:07.000" end="00:00:06.000">End before begin.</p>
      <p begin="00:00:08.000" end="00:00:09.000"><span tts:color="#GGGGGG">Bad colour</span> &unknownentity; &#xZZ; & lone ampersand</p>
      <p begin="00:00:09.000" end="00:00:10.000"><span>Unclosed span</p>
      <p begin="00:00:10.000" end="00:00:11.000">Mismatched </span>closing tag.</p>
      <p begin="00:00:11.000" end="00:00:12.000">Nested <p>paragraph</p> inside a paragraph.</p>
      <p begin="00:00:12.000" end="00:00:13.000">Text with <![CDATA[a <cdata> block & more]]> inside.</p>
      <!-- an unterminated comment
      <p begin="00:00:13.000" end="00:00:14.000">After the comment.</p>
    </div>
  </body>
