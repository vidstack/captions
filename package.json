{
  "name": "media-captions",
  "version": "1.0.4",
  "description": "Media captions parser and renderer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/prod.js",
  "types": "./dist/prod.d.ts",
  "sideEffects": false,
  "jsdelivr": "./dist/prod.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "styles/"
  ],
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "clean": "rimraf dist",
    "format": "prettier src tests --write --log-level warn",
    "changelog": "pnpm exec git cliff --output CHANGELOG.md",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "sandbox": "node ./.sandbox/launch.js",
    "release": "pnpm validate && pnpm changelog && git push --follow-tags origin main && npm publish --tag next",
    "validate": "pnpm typecheck && pnpm test && pnpm build",
    "test:unit": "vitest --run --project unit",
    "test:browser": "vitest --run --project browser",
    "screenshots": "node ./scripts/screenshots.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.4.1",
    "@vitest/browser-playwright": "^4.1.11",
    "git-cliff": "^2.13.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.7",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "undici": "^8.10.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "contributors": [
    "Rahim Alwer <rahim.alwer@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vidstack/media-captions.git"
  },
  "bugs": {
    "url": "https://github.com/vidstack/media-captions/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/prod.d.ts",
      "test": "./dist/dev.js",
      "development": "./dist/dev.js",
      "default": "./dist/prod.js"
    },
    "./cea": {
      "types": "./dist/prod-cea.d.ts",
      "test": "./dist/dev-cea.js",
      "development": "./dist/dev-cea.js",
      "default": "./dist/prod-cea.js"
    },
    "./element": {
      "types": "./dist/prod-element.d.ts",
      "test": "./dist/dev-element.js",
      "development": "./dist/dev-element.js",
      "default": "./dist/prod-element.js"
    },
    "./parsers/vtt": {
      "types": "./dist/prod-parser-vtt.d.ts",
      "test": "./dist/dev-parser-vtt.js",
      "development": "./dist/dev-parser-vtt.js",
      "default": "./dist/prod-parser-vtt.js"
    },
    "./parsers/srt": {
      "types": "./dist/prod-parser-srt.d.ts",
      "test": "./dist/dev-parser-srt.js",
      "development": "./dist/dev-parser-srt.js",
      "default": "./dist/prod-parser-srt.js"
    },
    "./parsers/ssa": {
      "types": "./dist/prod-parser-ssa.d.ts",
      "test": "./dist/dev-parser-ssa.js",
      "development": "./dist/dev-parser-ssa.js",
      "default": "./dist/prod-parser-ssa.js"
    },
    "./parsers/ttml": {
      "types": "./dist/prod-parser-ttml.d.ts",
      "test": "./dist/dev-parser-ttml.js",
      "development": "./dist/dev-parser-ttml.js",
      "default": "./dist/prod-parser-ttml.js"
    },
    "./parsers/scc": {
      "types": "./dist/prod-parser-scc.d.ts",
      "test": "./dist/dev-parser-scc.js",
      "development": "./dist/dev-parser-scc.js",
      "default": "./dist/prod-parser-scc.js"
    },
    "./parsers/lrc": {
      "types": "./dist/prod-parser-lrc.d.ts",
      "test": "./dist/dev-parser-lrc.js",
      "development": "./dist/dev-parser-lrc.js",
      "default": "./dist/prod-parser-lrc.js"
    },
    "./parsers/sbv": {
      "types": "./dist/prod-parser-sbv.d.ts",
      "test": "./dist/dev-parser-sbv.js",
      "development": "./dist/dev-parser-sbv.js",
      "default": "./dist/prod-parser-sbv.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ass",
    "captions",
    "cea-608",
    "cea-708",
    "cues",
    "custom-element",
    "engine",
    "fast",
    "lightweight",
    "media",
    "parser",
    "player",
    "regions",
    "scc",
    "srt",
    "ssa",
    "streaming",
    "text-tracks",
    "ts",
    "ttml",
    "typescript",
    "video",
    "vidstack",
    "vtt",
    "web",
    "web-component"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
